# Copy this file to .streamlit/secrets.toml only on the private host.
# Never commit the real secrets.toml file.

[auth]
redirect_uri = "https://toolbox.example.com/oauth2callback"
cookie_secret = "replace-with-a-long-random-secret"
client_id = "replace-with-oidc-client-id"
client_secret = "replace-with-oidc-client-secret"
server_metadata_url = "https://identity-provider.example.com/.well-known/openid-configuration"
