# Copy this file to .streamlit/secrets.toml only in the deployment environment.
# Never commit the real secrets.toml file.

[auth]
# Must exactly match the Google OAuth client's authorized redirect URI.
# Hosted example: https://your-private-toolbox.example.com/oauth2callback
redirect_uri = "https://YOUR_HOSTNAME/oauth2callback"

# Generate a strong random value and keep it secret.
cookie_secret = "REPLACE_WITH_STRONG_RANDOM_SECRET"

# From Google Auth Platform -> Clients -> your Web application client.
client_id = "REPLACE_WITH_GOOGLE_CLIENT_ID"
client_secret = "REPLACE_WITH_GOOGLE_CLIENT_SECRET"

# Google's shared OpenID Connect discovery document.
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
